# Directory path for storing uploaded files
STORAGE_PATH=upload

# Maximum upload size for a single file (in MB)
MAX_FILE_SIZE_MB=100

# Maximum total upload size for all files in a single share (in MB)
MAX_TOTAL_FILE_SIZE_MB=100

# Default share expiration time (in days)
DEFAULT_EXPIRY_DAYS=2

# Maximum share expiration time allowed for guest users (in days)
MAX_GUEST_EXIRY_DAYS=5

# Default download limit count per share
DEFAULT_DOWNLOAD_LIMIT=5

# Maximum download limit count allowed for guest users
MAX_GUEST_DOWNLOAD_LIMIT=5

# Database connection URL (SQLite in dev, PostgreSQL in prod)
DATABASE_URL=sqlite+aiosqlite:///database.db

# Frontend origin URL for CORS and QR code generation (no trailing slash)
FRONTEND_URL=http://localhost:5173

